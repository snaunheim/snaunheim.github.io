<ul class="card-text font-weight-light list-group list-group-flush">
  {% assign work = data[1] | sort: 'startDate' | reverse %}
  {% for content in work %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-xs-2 cl-sm-2 col-md-2 text-center" style="width: 75px; margin-right: 1.5rem; margin-left: -0.5rem;">
          {% if content.startDate %}
            {% assign start_parts = content.startDate | split: '-' %}
            {% assign start_display = start_parts[1] | append: '/' | append: start_parts[0] %}
            {% assign date = start_display | append: ' - ' %}
            {% if content.endDate == 'now' or content.endDate == '' %}
              {% assign date = date | append: 'now' %}
              {% assign displayEndDate = 'now' %}
            {% else %}
              {% assign end_parts = content.endDate | split: '-' %}
              {% assign end_display = end_parts[1] | append: '/' | append: end_parts[0] %}
              {% assign date = date | append: end_display %}
              {% assign displayEndDate = content.endDate %}
            {% endif %}
          {% else %}
            {% assign date = '' %}
          {% endif %}
          <table class="table-cv">
            <tbody>
              <tr>
                <td style="padding-bottom: 0.5rem; padding-top: 0;">
                  <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px"> {{ date }} </span>
                </td>
              </tr>
              {% if content.location %}
                <tr>
                  <td>
                    <p class="location">
                      <i class="fa-solid fa-location-dot iconlocation"></i>
                      {{ content.location }}
                    </p>
                  </td>
                </tr>
              {% endif %}
            </tbody>
          </table>
        </div>
        <div class="col-xs-10 cl-sm-10 col-md-10" style="padding-left: 0; flex: 1; max-width: calc(100% - 90px);">
          <h6 class="title font-weight-bold ml-1 ml-md-4" style="margin-top: 0;">
            <a href="{{ content.url }}">{{ content.position }}</a>
          </h6>
          <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">{{ content.name }}</h6>
          <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem; font-style: italic">{{ content.summary }}</h6>
          <ul class="items">
            {% for item in content.highlights %}
              <li>
                <span class="item">{{ item }}</span>
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </li>
  {% endfor %}
</ul>

<ul class="card-text font-weight-light list-group list-group-flush">
  {% assign education = data[1] | sort: 'startDate' | reverse %}
  {% for content in education %}
    <li class="list-group-item">
      {% if content.startDate and content.startDate != '' %}
        {% assign start_parts = content.startDate | split: '-' %}
        {% assign start_display = start_parts[1] | append: '/' | append: start_parts[0] %}
        {% assign date = start_display | append: ' - ' %}
        {% if content.endDate == 'now' or content.endDate == '' %}
          {% assign date = date | append: 'now' %}
          {% assign displayEndDate = 'now' %}
        {% else %}
          {% assign end_parts = content.endDate | split: '-' %}
          {% assign end_display = end_parts[1] | append: '/' | append: end_parts[0] %}
          {% assign date = date | append: end_display %}
          {% assign displayEndDate = content.endDate %}
        {% endif %}
      {% else %}
        {% assign date = null %}
      {% endif %}

      <div class="mb-2">
        {% if date %}
          <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="white-space: nowrap;"> {{ date }} </span>
        {% endif %}
        {% if content.location %}
          <span class="location ml-2" style="font-size: 0.85rem;">
            <i class="fa-solid fa-location-dot iconlocation"></i>
            {{ content.location }}
          </span>
        {% endif %}
      </div>

      <div>
        <h6 class="title font-weight-bold" style="margin-top: 0;">
          <a href="{{ content.url }}">{{ content.studyType }}</a>
        </h6>
        <h6 style="font-size: 0.95rem;">{{ content.institution }}</h6>
        <h6 style="font-size: 0.95rem; font-style: italic;">{{ content.area }}</h6>
        {% if content.thesis %}
          <p style="font-size: 0.9rem; margin-top: 0.5rem;">
            <strong>Thesis:</strong> <a href="https://{{ content.thesis.url }}" target="_blank">{{ content.thesis.title }}</a>
          </p>
        {% endif %}
        <ul class="items">
          {% for item in content.courses %}
            <li>
              <span class="item">{{ item }}</span>
            </li>
          {% endfor %}
        </ul>
      </div>
    </li>
  {% endfor %}
</ul>
